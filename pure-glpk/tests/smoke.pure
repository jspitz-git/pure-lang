namespace smoke;

check name condition
  = () if condition;
  = fprintf stderr "pure-glpk smoke failed: %s\n" name $$ exit 1 otherwise;

close actual expected tolerance =
  abs (actual-expected) <= tolerance;

errorp value = index (str value) "glp::error" >= 0;

using glpk;

callback_reasonp reason =
  reason === glp::irowgen || reason === glp::ibingo ||
  reason === glp::iheur || reason === glp::icutgen ||
  reason === glp::ibranch || reason === glp::iselect ||
  reason === glp::iprepro;

let callback_invocations, callback_info_seen, retained_tree,
    retain_callback_tree, callback_reason, callback_reason_valid =
      ref 0, ref false, ref NULL, ref true, ref NULL, ref false;
let callback_info = ref ();

namespace glp;
mip_cb tree info = () when
  put smoke::callback_invocations (get smoke::callback_invocations+1);
  put smoke::callback_info_seen (info === smoke::callback_info);
  put smoke::callback_reason (glp::ios_reason tree);
  put smoke::callback_reason_valid
    (smoke::callback_reasonp (get smoke::callback_reason));
  if get smoke::retain_callback_tree
    then put smoke::retained_tree tree
    else ();
end;
namespace smoke;

smoke::make_lp =
  lp when
    lp = glp::create_prob;
    glp::set_obj_dir lp glp::max;
    glp::add_rows lp 3;
    glp::set_row_bnds lp (1, glp::up, 0.0, 4.0);
    glp::set_row_bnds lp (2, glp::up, 0.0, 2.0);
    glp::set_row_bnds lp (3, glp::up, 0.0, 3.0);
    glp::add_cols lp 2;
    glp::set_col_bnds lp (1, glp::lo, 0.0, 0.0);
    glp::set_col_bnds lp (2, glp::lo, 0.0, 0.0);
    glp::set_obj_coef lp (1, 3.0);
    glp::set_obj_coef lp (2, 2.0);
    glp::load_matrix lp
      [(1,1,1.0),(1,2,1.0),(2,1,1.0),(3,2,1.0)];
  end;

smoke::make_mip =
  lp when
    lp = glp::create_prob;
    glp::set_obj_dir lp glp::max;
    glp::add_rows lp 2;
    glp::set_row_bnds lp (1, glp::up, 0.0, 4.0);
    glp::set_row_bnds lp (2, glp::up, 0.0, 4.0);
    glp::add_cols lp 2;
    glp::set_col_bnds lp (1, glp::lo, 0.0, 0.0);
    glp::set_col_bnds lp (2, glp::lo, 0.0, 0.0);
    glp::set_col_kind lp (1, glp::iv);
    glp::set_col_kind lp (2, glp::iv);
    glp::set_obj_coef lp (1, 1.0);
    glp::set_obj_coef lp (2, 1.0);
    glp::load_matrix lp
      [(1,1,2.0),(1,2,1.0),(2,1,1.0),(2,2,2.0)];
  end;

let lp = smoke::make_lp;
smoke::check "LP solver return"
  (glp::simplex lp [(glp::msg_lev,glp::msg_off),
                    (glp::presolve,glp::on)] === glp::ok);
smoke::check "LP optimal status" (glp::get_status lp === glp::opt);
smoke::check "LP objective"
  (smoke::close (glp::get_obj_val lp) 10.0 1.0e-9);
smoke::check "LP x"
  (smoke::close (glp::get_col_prim lp 1) 2.0 1.0e-9);
smoke::check "LP y"
  (smoke::close (glp::get_col_prim lp 2) 2.0 1.0e-9);
smoke::check "bounds failure path"
  (smoke::errorp (glp::get_col_name lp 99));
smoke::check "LP cleanup" (glp::delete_prob lp === ());
smoke::check "stale LP handle rejected" (~intp (glp::get_num_cols lp));

let mip = smoke::make_mip;
smoke::check "MIP relaxation"
  (glp::simplex mip [(glp::msg_lev,glp::msg_off)] === glp::ok);
smoke::check "MIP solver return"
  (glp::intopt mip [(glp::msg_lev,glp::msg_off),
                    (glp::cb_func,glp::on),
                    (glp::cb_info,callback_info)] === glp::ok);
smoke::check "MIP callback invoked" (get callback_invocations > 0);
smoke::check "MIP callback info" (get callback_info_seen);
smoke::check "callback ios_reason was not one of seven GLPK reason symbols"
  (get callback_reason_valid);
let stale_callback_reason = glp::ios_reason (get retained_tree);
smoke::check "retained callback tree returned a valid reason after intopt"
  (~smoke::callback_reasonp stale_callback_reason);
smoke::check "MIP optimal status" (glp::mip_status mip === glp::opt);
smoke::check "MIP objective"
  (smoke::close (glp::mip_obj_val mip) 2.0 1.0e-9);
smoke::check "MIP integer x"
  (smoke::close (glp::mip_col_val mip 1)
                (round (glp::mip_col_val mip 1)) 1.0e-9);
smoke::check "MIP integer y"
  (smoke::close (glp::mip_col_val mip 2)
                (round (glp::mip_col_val mip 2)) 1.0e-9);
smoke::check "MIP cleanup" (glp::delete_prob mip === ());

let no_retain_callbacks = get callback_invocations;
put retain_callback_tree false;
let no_retain_mip = smoke::make_mip;
smoke::check "MIP without retained callback tree relaxation"
  (glp::simplex no_retain_mip [(glp::msg_lev,glp::msg_off)] === glp::ok);
smoke::check "MIP without retained callback tree solver return"
  (glp::intopt no_retain_mip [(glp::msg_lev,glp::msg_off),
                              (glp::cb_func,glp::on),
                              (glp::cb_info,callback_info)] === glp::ok);
smoke::check "MIP callback ran without retaining tree"
  (get callback_invocations > no_retain_callbacks);
smoke::check "MIP without retained callback tree cleanup"
  (glp::delete_prob no_retain_mip === ());
