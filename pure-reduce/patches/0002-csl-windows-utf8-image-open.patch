+static wchar_t *widenUtf8(const char *text)
+{
+    if (text == nullptr) return nullptr;
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                                     text, -1, nullptr, 0);
+    if (length == 0) return nullptr;
+    wchar_t *wide = new (std::nothrow) wchar_t[length];
+    if (wide == nullptr) return nullptr;
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                            text, -1, wide, length) != length)
+    {   delete [] wide;
+        return nullptr;
+    }
+    return wide;
+}
+
+std::FILE *windowsFopenUtf8(const char *name, const char *mode)
+{
+    wchar_t *wideName = widenUtf8(name);
+    if (wideName == nullptr) return nullptr;
+    wchar_t *wideMode = widenUtf8(mode);
+    if (wideMode == nullptr)
+    {   delete [] wideName;
+        return nullptr;
+    }
+    std::FILE *result = ::_wfopen(wideName, wideMode);
+    delete [] wideMode;
+    delete [] wideName;
+    return result;
+}
+
+int windowsFileStatusUtf8(const char *name)
+{
+    wchar_t *wideName = widenUtf8(name);
+    if (wideName == nullptr) return 0;
+    DWORD attributes = GetFileAttributesW(wideName);
+    delete [] wideName;
+    if (attributes == INVALID_FILE_ATTRIBUTES) return 0;
+    return (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ? 2 : 1;
+}
+
