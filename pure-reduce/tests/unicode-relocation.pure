using system, reduce;

check name condition
  = () if condition;
  = fprintf stderr "FAIL: %s\n" name $$ exit 1 otherwise;

check "relocated bridge starts lazily" (reduce::pure_reduce_state == 0);
check "relocated bridge evaluates" (simplify (1+1) === 2);
check "relocated bridge is running" (reduce::pure_reduce_state == 1);
reduce::finish;
check "relocated bridge finishes" (reduce::pure_reduce_state == 2);

puts "pure-reduce unicode-relocation passed";
