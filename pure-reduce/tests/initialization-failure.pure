using system, reduce;

check name condition
  = () if condition;
  = fprintf stderr "FAIL: %s\n" name $$ exit 1 otherwise;

is_initialization_error (reduce::initialization_error _) = true;
is_initialization_error _ = false otherwise;

let initialization_failed = catch is_initialization_error
  (reduce::test_initialization_failure $$ false);
check "mandatory setup failure is categorized" initialization_failed;
check "failed initialization is not running" (reduce::pure_reduce_state == 2);

puts "pure-reduce initialization-failure passed";
