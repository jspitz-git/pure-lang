using system, reduce;

check name condition
  = () if condition;
  = fprintf stderr "FAIL: %s\n" name $$ exit 1 otherwise;

check "feed is the first REDUCE operation"
  (reduce::pure_reduce_state == 0);
reduce::feed "(list 7 8 9)\n";
check "first feed starts REDUCE"
  (reduce::pure_reduce_state == 1);
check "first-operation feed remains installed after lazy startup"
  (lisp ('eval read) === [7,8,9]);
reduce::finish;
check "first-feed lifecycle finishes cleanly"
  (reduce::pure_reduce_state == 2);

// CSL echoes the fed expression without consuming its trailing newline.
puts "";
puts "pure-reduce first-feed passed";
