foreach(row IN LISTS policy)
  string(REPLACE "|" ";" fields "${row}")
  list(LENGTH fields count)
  if(NOT count EQUAL 9)
    message(FATAL_ERROR "install audit: malformed artifact policy")
  endif()
  list(GET fields 0 component)
  list(GET fields 1 destination)
  list(GET fields 2 source)
  list(GET fields 3 expected)
  list(GET fields 8 mapping)
  install_relative("${destination}")
  string(TOLOWER "${destination}" lower)
  if(lower IN_LIST destinations OR NOT component MATCHES "^(runtime|documentation)$" OR mapping STREQUAL "")
    message(FATAL_ERROR "install audit: duplicate destination, component or license mapping")
  endif()
  list(APPEND destinations "${lower}")
  gl_install_path("${source}" file source)
  list(APPEND sources "${source}")
  file(SHA256 "${source}" hash)
  file(SIZE "${source}" size)
  if(expected STREQUAL "NATIVE_COMPLETED_MODULE" AND
      source STREQUAL "${GL_INSTALL_BUILD_DIR}/pure-gl.dll")
    set(expected "${GL_INSTALL_MODULE_SHA256}")
  endif()
  if(NOT hash STREQUAL expected)
    message(FATAL_ERROR "install audit: configured source hash mismatch: ${source}")
  endif()
  list(GET fields 4 project)
  list(GET fields 5 version)
  list(GET fields 6 url)
  list(GET fields 7 license)
  if(destination STREQUAL "bin/libfreeglut.dll" OR
      destination STREQUAL "share/doc/pure-gl/licenses/FreeGLUT.txt")
    if(destination STREQUAL "bin/libfreeglut.dll")
      gl_pe_equal_path("${source}" "${PURE_GL_CLANG64_PREFIX}/bin/libfreeglut.dll")
      set(pinned a297e3b3fa824de6eb21285e23a409fbbf0bc573c60dd04c227bbc89d8398519)
      set(want_component runtime)
    else()
      gl_pe_equal_path("${source}" "${PURE_GL_CLANG64_PREFIX}/share/licenses/freeglut/COPYING")
      set(pinned b6593d5ec4c113a274abb85b10e8615895cb0ddb89f7912af5fe5aa8df38a275)
      set(want_component documentation)
    endif()
    if(NOT hash STREQUAL pinned OR NOT expected STREQUAL pinned OR
        NOT project STREQUAL FreeGLUT OR NOT version STREQUAL "3.8.0" OR
        NOT url STREQUAL "https://github.com/FreeGLUTProject/freeglut/releases/download/v3.8.0/freeglut-3.8.0.tar.gz" OR
        NOT license STREQUAL MIT OR NOT component STREQUAL want_component OR
        NOT mapping STREQUAL "share/doc/pure-gl/licenses/FreeGLUT.txt")
      message(FATAL_ERROR "install audit: FreeGLUT runtime/license identity mismatch")
    endif()
  elseif(NOT project STREQUAL pure-gl OR NOT version STREQUAL "0.9" OR
      NOT url STREQUAL "https://github.com/agraef/pure-lang/tree/master/pure-gl" OR
      NOT license STREQUAL BSD-3-Clause OR NOT mapping STREQUAL "share/doc/pure-gl/COPYING")
    message(FATAL_ERROR "install audit: pure-gl package/license identity mismatch")
  endif()
  list(REMOVE_AT fields 3)
  list(INSERT fields 3 "${hash}")
  list(JOIN fields "|" row)
  list(APPEND sealed "${row}")
  list(APPEND delta_${component} "${destination}|f|${size}|${hash}")
endforeach()
