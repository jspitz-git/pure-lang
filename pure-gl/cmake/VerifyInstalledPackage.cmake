# Derive directory ownership from the canonical baseline and fixed artifact
# destinations. Shared existing ancestors remain baseline; no overlapping deltas.
foreach(component runtime documentation)
  foreach(row IN LISTS delta_${component})
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 destination)
    get_filename_component(parent "${destination}" DIRECTORY)
    while(NOT parent STREQUAL "")
      if(NOT "${parent}|d|0|-" IN_LIST baseline)
        list(APPEND dirs_${component} "${parent}|d|0|-")
      endif()
      get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
  endforeach()
  list(APPEND delta_${component} ${dirs_${component}})
  list(REMOVE_DUPLICATES delta_${component})
  list(SORT delta_${component})
endforeach()
set(owned_paths)
foreach(component runtime documentation)
  foreach(row IN LISTS delta_${component})
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 path)
    string(TOLOWER "${path}" lower)
    if(lower IN_LIST owned_paths)
      message(FATAL_ERROR "install audit: overlapping component delta")
    endif()
    list(APPEND owned_paths "${lower}")
  endforeach()
endforeach()
