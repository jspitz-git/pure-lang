function(gl_install_path path kind output)
  file(TO_CMAKE_PATH "${path}" path)
  gl_pe_path("${path}" "${kind}")
  set(${output} "${path}" PARENT_SCOPE)
endfunction()
function(gl_install_no_reparse)
  if(EXISTS "${GL_INSTALL_GUARD}")
    foreach(path IN LISTS ARGN)
      gl_pe_path("${path}" any)
    endforeach()
    execute_process(COMMAND "${GL_INSTALL_GUARD}" --check-paths ${ARGN}
      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "install audit: native no-reparse validation failed\n${out}${err}")
    endif()
  else()
    gl_pe_no_reparse(${ARGN})
  endif()
endfunction()
function(gl_install_windows_authority)
  gl_pe_equal_path("${PURE_GL_WINDOWS_SYSTEM_DIRECTORY}" "${install_system}")
endfunction()

function(install_relative path)
  string(TOLOWER "${path}" lower)
  if(NOT path MATCHES "^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*$" OR
      path MATCHES "(^|/)\\.\\.?(/|$)" OR path MATCHES "[.](/|$)" OR
      lower MATCHES "(^|/)(con|prn|aux|nul|com[0-9]|lpt[0-9])([./]|$)")
    message(FATAL_ERROR "install audit: malformed relative path ${path}")
  endif()
endfunction()
function(install_rows text output)
  if(text MATCHES "[;\r]" OR text MATCHES "\n\n" OR NOT text MATCHES "\n$")
    message(FATAL_ERROR "install audit: malformed record stream")
  endif()
  string(REGEX REPLACE "\n$" "" text "${text}")
  string(REPLACE "\n" ";" rows "${text}")
  set(${output} "${rows}" PARENT_SCOPE)
endfunction()
function(install_tree root output)
  if(DEFINED ENV{PURE_GL_INSTALL_CHANNEL} AND root STREQUAL STAGE_PREFIX AND
      NOT GL_INSTALL_MODE STREQUAL "seal")
    execute_process(COMMAND "${GL_INSTALL_GUARD}" --tree --scope "${STAGE_PREFIX}" "${GL_INSTALL_BUILD_DIR}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE content ERROR_VARIABLE err TIMEOUT 40)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "install audit: retained tree snapshot failed (${rc})\n${err}")
    endif()
    install_rows("${content}" rows)
    set(seen)
    foreach(row IN LISTS rows)
      string(REPLACE "|" ";" fields "${row}")
      list(LENGTH fields count)
      if(NOT count EQUAL 4)
        message(FATAL_ERROR "install audit: malformed retained tree record")
      endif()
      list(GET fields 0 path)
      install_relative("${path}")
      string(TOLOWER "${path}" lower)
      if(lower IN_LIST seen)
        message(FATAL_ERROR "install audit: case-ambiguous retained tree")
      endif()
      list(APPEND seen "${lower}")
    endforeach()
    list(SORT rows)
    set(${output} "${rows}" PARENT_SCOPE)
    return()
  endif()
  gl_install_path("${root}" directory root)
  gl_install_no_reparse("${root}")
  if(EXISTS "${GL_INSTALL_GUARD}")
    execute_process(COMMAND "${GL_INSTALL_GUARD}" --check-tree "${root}" RESULT_VARIABLE rc TIMEOUT 30)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "install audit: non-regular, reparse or hardlinked tree")
    endif()
  endif()
  # CMP0009 prohibits link traversal; validate every discovered endpoint and
  # ancestor before hashing. Empty directories are part of the exact contract.
  file(GLOB_RECURSE paths LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*")
  list(SORT paths)
  set(absolute)
  set(seen)
  foreach(path IN LISTS paths)
    install_relative("${path}")
    string(TOLOWER "${path}" folded)
    if(folded IN_LIST seen)
      message(FATAL_ERROR "install audit: case-ambiguous tree path ${path}")
    endif()
    list(APPEND seen "${folded}")
    list(APPEND absolute "${root}/${path}")
  endforeach()
  if(absolute AND NOT EXISTS "${GL_INSTALL_GUARD}")
    gl_install_no_reparse(${absolute})
  endif()
  set(rows)
  foreach(path IN LISTS paths)
    if(IS_DIRECTORY "${root}/${path}")
      list(APPEND rows "${path}|d|0|-")
    else()
      file(SIZE "${root}/${path}" size)
      file(SHA256 "${root}/${path}" hash)
      list(APPEND rows "${path}|f|${size}|${hash}")
    endif()
  endforeach()
  list(SORT rows)
  set(${output} "${rows}" PARENT_SCOPE)
endfunction()
function(install_guard_operation operation)
  if(operation STREQUAL "--queue-write" OR operation STREQUAL "--write")
    execute_process(COMMAND "${GL_INSTALL_GUARD}" "${operation}" "${ARGV1}" "${ARGV2}"
      --scope "${STAGE_PREFIX}" "${GL_INSTALL_BUILD_DIR}" RESULT_VARIABLE rc TIMEOUT 40)
  else()
    execute_process(COMMAND "${GL_INSTALL_GUARD}" ${ARGV}
      --scope "${STAGE_PREFIX}" "${GL_INSTALL_BUILD_DIR}" RESULT_VARIABLE rc TIMEOUT 40)
  endif()
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "install audit: guarded operation failed (${rc})")
  endif()
endfunction()
function(install_queue_rows path rows)
  list(JOIN rows "\n" content)
  if(rows)
    string(APPEND content "\n")
  endif()
  install_guard_operation(--queue-write "${path}" "${content}")
endfunction()
function(install_read_tree path output)
  gl_install_path("${path}" file checked)
  gl_install_no_reparse("${checked}")
  file(READ "${path}" content)
  install_rows("${content}" rows)
  set(seen)
  foreach(row IN LISTS rows)
    string(REPLACE "|" ";" fields "${row}")
    list(LENGTH fields count)
    if(NOT count EQUAL 4)
      message(FATAL_ERROR "install audit: malformed tree manifest ${path}")
    endif()
    list(GET fields 0 name)
    list(GET fields 1 type)
    list(GET fields 2 size)
    list(GET fields 3 hash)
    install_relative("${name}")
    string(LENGTH "${hash}" length)
    string(TOLOWER "${name}" lower)
    if(lower IN_LIST seen OR NOT size MATCHES "^(0|[1-9][0-9]*)$" OR
        (type STREQUAL "f" AND (NOT hash MATCHES "^[a-f0-9]+$" OR NOT length EQUAL 64)) OR
        (type STREQUAL "d" AND (NOT size STREQUAL "0" OR NOT hash STREQUAL "-")) OR
        NOT type MATCHES "^[fd]$")
      message(FATAL_ERROR "install audit: duplicate/malformed tree manifest ${path}")
    endif()
    list(APPEND seen "${lower}")
  endforeach()
  set(sorted "${rows}")
  list(SORT sorted)
  if(NOT sorted STREQUAL rows)
    message(FATAL_ERROR "install audit: unsorted tree manifest ${path}")
  endif()
  set(${output} "${rows}" PARENT_SCOPE)
endfunction()
