endif()

# Both functional tests consume only the stage and run outside source/build.
# The installed FreeGLUT directory is also Pure/bin. Pass it only once: the
# Task 1 supervisor deliberately rejects duplicate runtime PATH entries.
set(staged_inputs)
foreach(name GL GL_ARB GL_EXT GL_NV GL_ATI GLU GLUT)
  list(APPEND staged_inputs --input "${stage}/lib/pure/${name}.pure")
endforeach()
# Pure 0.68 mixes its UTF-8 default libdir with narrow Windows CRT file APIs.
# Only the executable spelling uses a verified Windows ASCII alias of the same
# physical stage. Every ownership/hash/provenance/script/module path stays canonical.
execute_process(COMMAND "${GL_INSTALL_RUNNER}" --print-pure-executable-alias "${stage}/bin/pure.exe"
  RESULT_VARIABLE alias_rc OUTPUT_VARIABLE staged_pure_alias ERROR_VARIABLE alias_err
  OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 20)
if(NOT alias_rc EQUAL 0 OR staged_pure_alias STREQUAL "" OR NOT alias_err STREQUAL "")
  message(FATAL_ERROR "install audit: same-stage ASCII executable alias unavailable (${alias_rc}): ${alias_err}")
endif()
foreach(case load hidden-render)
  execute_process(COMMAND "${GL_INSTALL_RUNNER}"
    --pure "${stage}/bin/pure.exe"
    --pure-executable-alias "${staged_pure_alias}"
    --script "${stage}/share/doc/pure-gl/tests/${case}.pure"
    --timeout-ms 90000 --cwd "${install_windows_root}"
    ${staged_inputs} --input "${stage}/lib/pure/pure-gl.dll"
    --input "${stage}/bin/libfreeglut.dll" --include "${stage}/lib/pure"
    --library "${stage}/lib/pure" --path-entry "${stage}/bin"
    --path-entry "${stage}/lib/pure" --path-entry "${PURE_GL_WINDOWS_SYSTEM_DIRECTORY}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 100)
  if(NOT rc EQUAL 0 OR NOT err STREQUAL "")
    message(FATAL_ERROR "install audit: staged ${case} failed (${rc})\n${out}${err}")
  endif()
  message(STATUS "${out}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}"
  "-DLLVM_READOBJ=${LLVM_READOBJ_EXECUTABLE}"
  "-DLLVM_READOBJ_SHA256=${LLVM_READOBJ_SHA256}"
  "-DLLVM_STRINGS=${LLVM_STRINGS_EXECUTABLE}"
  "-DLLVM_STRINGS_SHA256=${LLVM_STRINGS_SHA256}"
  "-DPURE_GL_MODULE=${stage}/lib/pure/pure-gl.dll"
  "-DFREEGLUT_DLL=${stage}/bin/libfreeglut.dll"
  "-DPURE_GL_PURE_PREFIX=${stage}"
  "-DPURE_GL_CLANG64_PREFIX=${PURE_GL_CLANG64_PREFIX}"
  "-DPURE_GL_WINDOWS_SYSTEM_DIRECTORY=${PURE_GL_WINDOWS_SYSTEM_DIRECTORY}"
  "-DPURE_GL_RUNTIME_DIRECTORY=${stage}/bin" -DPURE_GL_AUDIT_MODE=INSTALLED
  -P "${CMAKE_CURRENT_LIST_DIR}/VerifyWindowsDependencies.cmake"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT rc EQUAL 0 OR NOT err STREQUAL "" OR NOT out MATCHES "PURE_GL_PE_OK AMD64 non-system=12 imports=141 system=10")
  message(FATAL_ERROR "install audit: staged recursive PE closure failed\n${out}${err}")
endif()
message(STATUS "${out}")
install_tree("${stage}" final)
if(NOT final STREQUAL expected_tree)
  message(FATAL_ERROR "install audit: installed tests changed the exact stage")
endif()
list(LENGTH baseline baseline_count)
list(LENGTH final final_count)
set(delta_dirs ${dirs_runtime} ${dirs_documentation})
list(REMOVE_DUPLICATES delta_dirs)
list(LENGTH delta_dirs directory_count)
set(baseline_files 0)
foreach(row IN LISTS baseline)
  if(row MATCHES "[|]f[|]")
    math(EXPR baseline_files "${baseline_files}+1")
  endif()
endforeach()
math(EXPR baseline_dirs "${baseline_count}-${baseline_files}")
message(STATUS "PURE_GL_INSTALL_PACKAGE_OK baseline=${baseline_count} baseline_files=${baseline_files} baseline_directories=${baseline_dirs} runtime=${runtime_count} documentation=${documentation_count} delta_files=${artifact_count} delta_directories=${directory_count} final=${final_count} pe=22 installed_tests=2 license_payloads=1")
