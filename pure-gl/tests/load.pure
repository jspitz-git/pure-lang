using GL, GL_ARB, GL_EXT, GL_NV, GL_ATI, GLU, GLUT, system;

verify_all_families = ()
when
  GL::VERSION_1_1 == 1 &&
  GL::TEXTURE0_ARB == 33984 &&
  GL::ABGR_EXT == 32768 &&
  GL::FOG_DISTANCE_MODE_NV == 34138 &&
  GL::ELEMENT_ARRAY_ATI == 34664 &&
  GLU::VERSION == 100800 &&
  GLUT::API_VERSION == 4
    || throw "pure-gl module coverage failed";
  puts "PURE_GL_ALL_FAMILIES_OK";
end;

complete token = printf "PURE_GL_TEST_OK %s\n" token;

#argv == 2
  || throw "pure-gl load test requires exactly one completion token argument";
let token = last argv;

verify_all_families;

puts "pure-gl: loaded GL, GL_ARB, GL_EXT, GL_NV, GL_ATI, GLU, and GLUT";
complete token;
