using octave, system, strings;

callback_error _ = throw "callback failure";

has_prefix expected text =
  #text >= #expected && substr text 0 (#expected) == expected;

octave_eval "if =" ~== 0 || exit 10;
has_prefix "Octave evaluation failed: syntax error" octave_last_error ||
  (puts octave_last_error $$ exit 11);
octave_eval "assert (2 + 2 == 4);" == 0 || exit 12;
octave_last_error == "" || exit 13;

octave_call "pure_call" 1 ("callback_error",1) $$ true;
octave_last_error ==
  "Octave function call failed: pure_call: Pure exception in 'callback_error': \"callback failure\"" ||
  exit 14;

let matrix_values = {1.25,2.5;3.75,4.0};
octave_call "double" 1 matrix_values == matrix_values || exit 15;
octave_last_error == "" || exit 16;

octave_call "task4_missing_octave_function" 1 1 $$ true;
octave_last_error ==
  "Octave function call failed: feval: function 'task4_missing_octave_function' not found" ||
  exit 17;

octave_call "gcd" 1 (10,15) == 5 || exit 18;
octave_last_error == "" || exit 19;

puts "PURE_OCTAVE_ERRORS_OK";
