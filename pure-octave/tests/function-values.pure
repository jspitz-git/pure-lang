using octave, math, system;

chain_finalizer counter x = sentry (chained (get_sentry x)) x with
  chained original pointer =
    original pointer $$ put counter (get counter+1);
end;

exercise_pair counter i = ok when
  eig0 = octave_func "eig";
  add0 = octave_func ("x+y","x","y");
  ok = octave_valuep eig0 && octave_valuep add0 &&
    octave_call eig0 1 {2.0,0.0;0.0,3.0} == {2.0;3.0} &&
    octave_call add0 1 (i+0.25,0.75) == i+1.0;
  eig = chain_finalizer counter eig0;
  add = chain_finalizer counter add0;
  ok = ok && cookedp eig && cookedp add;
end;

exercise_cycle counter n = all id [exercise_pair counter i | i = 1..n];

let finalized = ref 0;
let per_cycle = 6;

exercise_cycle finalized per_cycle || exit 10;
get finalized == 2*per_cycle || exit 11;

exercise_cycle finalized per_cycle || exit 12;
get finalized == 4*per_cycle || exit 13;

exercise_cycle finalized per_cycle || exit 14;
get finalized == 6*per_cycle || exit 15;

exercise_cycle finalized per_cycle || exit 16;
get finalized == 8*per_cycle || exit 17;

exercise_cycle finalized per_cycle || exit 18;
get finalized == 10*per_cycle || exit 19;

octave_call "plus" 1 (20,22) == 42 || exit 20;

puts "PURE_OCTAVE_FUNCTION_VALUES_OK";
