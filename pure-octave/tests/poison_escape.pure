using system;

extern char *getenv(char*);

escape_write poison_path =
  (puts "PURE_OCTAVE_OUTSIDE_WRITE_DENIED_OK" $$ exit 14) when
  poison_file = fopen poison_path "w";
  _ = fputs "escaped audit root\n" poison_file;
  _ = fflush poison_file;
end;

let poison_path = getenv "PURE_OCTAVE_POISON_MARKER";
stringp poison_path && ~null poison_path || exit 10;
catch (\_->puts "PURE_OCTAVE_OUTSIDE_WRITE_DENIED_OK")
  (escape_write poison_path);
