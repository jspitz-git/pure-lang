diff --git a/liboctave/system/windows-system-volume-canonicalization.h b/liboctave/system/windows-system-volume-canonicalization.h
new file mode 100644
index 0000000..129f278
--- /dev/null
+++ b/liboctave/system/windows-system-volume-canonicalization.h
@@ -0,0 +1,180 @@
+#ifndef PURE_WINDOWS_SYSTEM_VOLUME_CANONICALIZATION_H
+#define PURE_WINDOWS_SYSTEM_VOLUME_CANONICALIZATION_H 1
+
+#include <windows.h>
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include <wctype.h>
+
+#if defined (NTDDI_VERSION) && NTDDI_VERSION >= 0x0A000007
+typedef char pure_file_normalized_name_info_must_be_24
+  [(FileNormalizedNameInfo == 24) ? 1 : -1];
+# define PURE_FILE_NORMALIZED_NAME_INFO FileNormalizedNameInfo
+#else
+/* minwinbase.h exposes the symbolic member only at the Windows 10 RS3
+   target.  The guarded branch above compile-checks its stable ABI value.  */
+# define PURE_FILE_NORMALIZED_NAME_INFO ((FILE_INFO_BY_HANDLE_CLASS) 24)
+#endif
+
+static FILE_NAME_INFO *
+pure_windows_query_normalized_name_info (HANDLE file, DWORD *length,
+                                         DWORD *error)
+{
+  const DWORD header = (DWORD) offsetof (FILE_NAME_INFO, FileName);
+  const DWORD maximum = header + 32767 * sizeof (wchar_t);
+  DWORD capacity = header + 512 * sizeof (wchar_t);
+
+  *length = 0;
+  *error = ERROR_SUCCESS;
+
+  while (capacity <= maximum)
+    {
+      FILE_NAME_INFO *info = (FILE_NAME_INFO *) calloc (1, capacity);
+      if (! info)
+        {
+          *error = ERROR_NOT_ENOUGH_MEMORY;
+          return NULL;
+        }
+
+      SetLastError (ERROR_SUCCESS);
+      if (GetFileInformationByHandleEx (
+            file, PURE_FILE_NORMALIZED_NAME_INFO, info, capacity))
+        {
+          DWORD bytes = info->FileNameLength;
+          DWORD available = capacity - header;
+          if (bytes == 0 || bytes % sizeof (wchar_t) != 0
+              || bytes > available)
+            {
+              *error = ERROR_INVALID_DATA;
+              free (info);
+              return NULL;
+            }
+
+          *length = bytes / sizeof (wchar_t);
+          return info;
+        }
+
+      *error = GetLastError ();
+      free (info);
+      if (*error != ERROR_MORE_DATA
+          && *error != ERROR_INSUFFICIENT_BUFFER)
+        return NULL;
+      if (capacity == maximum)
+        break;
+      capacity = capacity > maximum / 2 ? maximum : capacity * 2;
+    }
+
+  *error = ERROR_BUFFER_OVERFLOW;
+  return NULL;
+}
+
+static int
+pure_windows_valid_volume_relative_path (const wchar_t *path, DWORD length)
+{
+  DWORD index;
+  DWORD component_start = 1;
+
+  if (! path || length == 0 || path[0] != L'\\')
+    return 0;
+
+  for (index = 1; index <= length; index++)
+    {
+      wchar_t current = index == length ? L'\\' : path[index];
+      if (index < length
+          && (current == L'\0' || current == L'/' || current == L':'))
+        return 0;
+      if (current != L'\\')
+        continue;
+      if (index == component_start)
+        return length == 1 && index == 1;
+      if ((index - component_start == 1
+           && path[component_start] == L'.')
+          || (index - component_start == 2
+              && path[component_start] == L'.'
+              && path[component_start + 1] == L'.'))
+        return 0;
+      component_start = index + 1;
+    }
+
+  return 1;
+}
+
+static wchar_t *
+pure_windows_system_volume_canonical_path (HANDLE file,
+                                           const wchar_t *input,
+                                           DWORD *length,
+                                           DWORD *query_error)
+{
+  wchar_t volume_root[32767];
+  wchar_t system_directory[32767];
+  UINT system_length;
+  DWORD info_length = 0;
+  FILE_NAME_INFO *info = NULL;
+  wchar_t *result = NULL;
+
+  *length = 0;
+  *query_error = ERROR_SUCCESS;
+  if (! input || wcslen (input) < 3
+      || ! ((input[0] >= L'A' && input[0] <= L'Z')
+            || (input[0] >= L'a' && input[0] <= L'z'))
+      || input[1] != L':'
+      || (input[2] != L'\\' && input[2] != L'/'))
+    return NULL;
+
+  if (! GetVolumePathNameW (
+        input, volume_root,
+        (DWORD) (sizeof (volume_root) / sizeof (volume_root[0])))
+      || wcslen (volume_root) != 3 || volume_root[1] != L':'
+      || volume_root[2] != L'\\'
+      || towupper (volume_root[0]) != towupper (input[0])
+      || GetDriveTypeW (volume_root) != DRIVE_FIXED)
+    return NULL;
+
+  system_length
+    = GetSystemWindowsDirectoryW (
+        system_directory,
+        (UINT) (sizeof (system_directory) / sizeof (system_directory[0])));
+  if (system_length < 3 || system_length >= 32767
+      || ! ((system_directory[0] >= L'A'
+             && system_directory[0] <= L'Z')
+            || (system_directory[0] >= L'a'
+                && system_directory[0] <= L'z'))
+      || system_directory[1] != L':'
+      || (system_directory[2] != L'\\' && system_directory[2] != L'/')
+      || towupper (system_directory[0]) != towupper (volume_root[0]))
+    return NULL;
+
+  info = pure_windows_query_normalized_name_info (
+           file, &info_length, query_error);
+  if (! info
+      || ! pure_windows_valid_volume_relative_path (
+           info->FileName, info_length)
+      || info_length > 32767 - 7)
+    goto cleanup;
+
+  *length = 6 + info_length;
+  result = (wchar_t *) calloc ((size_t) *length + 1, sizeof (wchar_t));
+  if (! result)
+    {
+      *length = 0;
+      goto cleanup;
+    }
+  result[0] = L'\\';
+  result[1] = L'\\';
+  result[2] = L'?';
+  result[3] = L'\\';
+  result[4] = (wchar_t) towupper (system_directory[0]);
+  result[5] = L':';
+  memcpy (result + 6, info->FileName,
+          (size_t) info_length * sizeof (wchar_t));
+  result[*length] = L'\0';
+
+ cleanup:
+  free (info);
+  return result;
+}
+
+#endif
