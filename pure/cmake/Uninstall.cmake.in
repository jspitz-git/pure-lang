if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "Cannot find install manifest")
endif()

file(STRINGS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" installed_files)
foreach(installed_file IN LISTS installed_files)
  if(NOT "$ENV{DESTDIR}" STREQUAL "")
    set(installed_file "$ENV{DESTDIR}${installed_file}")
  endif()
  if(EXISTS "${installed_file}" OR IS_SYMLINK "${installed_file}")
    message(STATUS "Removing ${installed_file}")
    file(REMOVE "${installed_file}")
  else()
    message(STATUS "Already absent: ${installed_file}")
  endif()
endforeach()
