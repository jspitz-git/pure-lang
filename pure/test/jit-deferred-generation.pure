// Retained closures must preserve their generation before first invocation.

foo x = 101;
let f1 = foo;

clear foo
foo x = 201;
let f2 = foo;

clear foo
foo x = 301;
let f3 = foo;

f1 1;
f2 1;
f3 1;

clear f2
f3 2;
f1 2;

clear f3
f1 3;

clear f1
clear foo

// An uncalled superseded generation must be collectible as a snapshot.

bar x = 401;
let dormant = bar;
clear bar
bar x = 402;
clear dormant
bar 0;
clear bar
