extern int system(char *command);

using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/reference";
let reference_dsp = reference::newinit 48000;
reference::getNumInputs reference_dsp;
reference::getNumOutputs reference_dsp;
reference::info reference_dsp;
reference::meta;
reference::delete reference_dsp;

using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload";
let first = lifecycle_reload::newinit 48000;
let a_before = lifecycle_reload::getNumInputs first;
if a_before == 11 then () else throw "Faust A returned the wrong input count";

system "sleep 1";
system "cp @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle-b-unresolved.bc @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
system "touch @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload";
let a_after_failed_b = lifecycle_reload::getNumInputs first;
if a_after_failed_b == 11 then ()
else throw "failed Faust B reload damaged the live A instance";

system "sleep 1";
system "cp @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle-c.bc @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
system "touch @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload";
let a_after_rejected_c = lifecycle_reload::getNumInputs first;
if a_after_rejected_c == 11 then ()
else throw "rejected live-instance Faust C reload damaged A";
lifecycle_reload::delete first;

using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload";
let second = lifecycle_reload::newinit 48000;
let c_after_failed_b = lifecycle_reload::getNumInputs second;
if c_after_failed_b == 22 then ()
else throw "valid Faust C did not replace A after failed B";
lifecycle_reload::delete second;
puts "FAUST-LIVE-C 11 11 11 22";

system "sleep 1";
system "cp @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle-float.bc @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
system "touch @PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload.bc";
using "dsp:@PURE_FAUST_FIXTURE_OUTPUT_DIR@/lifecycle_reload";
let after_float_rejection = lifecycle_reload::newinit 48000;
let c_after_float = lifecycle_reload::getNumInputs after_float_rejection;
if c_after_float == 22 then ()
else throw "rejected float reload damaged Faust C";
lifecycle_reload::delete after_float_rejection;
puts "FAUST-FLOAT 22";
42;
