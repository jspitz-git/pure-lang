{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "llvm22-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "LLVM_DIR": "/usr/lib/llvm-22/lib/cmake/llvm",
        "PURE_STRICT_TOOLCHAIN": "ON"
      }
    },
    {
      "name": "llvm22-debug",
      "displayName": "LLVM 22 Debug",
      "description": "Clang/LLVM 22 debug build",
      "inherits": "llvm22-base",
      "binaryDir": "${sourceDir}/build/llvm22-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "llvm22-release",
      "displayName": "LLVM 22 Release",
      "description": "Clang/LLVM 22 optimized release build",
      "inherits": "llvm22-base",
      "binaryDir": "${sourceDir}/build/llvm22-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "llvm22-asan",
      "displayName": "LLVM 22 ASan and UBSan",
      "description": "Clang/LLVM 22 sanitizer build",
      "inherits": "llvm22-base",
      "binaryDir": "${sourceDir}/build/llvm22-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PURE_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "windows-clang64-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "PATH": "C:/msys64/clang64/bin;C:/msys64/usr/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/clang64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/clang64/bin/clang++.exe",
        "LLVM_DIR": "C:/msys64/clang64/lib/cmake/llvm",
        "PURE_FAUST_EXECUTABLE": "C:/Program Files/Faust/bin/faust.exe",
        "PURE_STRICT_TOOLCHAIN": "ON"
      }
    },
    {
      "name": "windows-clang64-debug",
      "displayName": "Windows CLANG64 Debug",
      "description": "Native Windows x86_64 MSYS2 CLANG64 debug build",
      "inherits": "windows-clang64-base",
      "binaryDir": "${sourceDir}/build/windows-clang64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/windows-clang64-debug-prefix"
      }
    },
    {
      "name": "windows-clang64-release",
      "displayName": "Windows CLANG64 Release",
      "description": "Native Windows x86_64 MSYS2 CLANG64 release build",
      "inherits": "windows-clang64-base",
      "binaryDir": "${sourceDir}/build/windows-clang64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/windows-clang64-prefix"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "llvm22-debug",
      "configurePreset": "llvm22-debug"
    },
    {
      "name": "llvm22-release",
      "configurePreset": "llvm22-release"
    },
    {
      "name": "llvm22-asan",
      "configurePreset": "llvm22-asan"
    },
    {
      "name": "windows-clang64-debug",
      "configurePreset": "windows-clang64-debug"
    },
    {
      "name": "windows-clang64-release",
      "configurePreset": "windows-clang64-release"
    }
  ],
  "testPresets": [
    {
      "name": "llvm22-debug",
      "configurePreset": "llvm22-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm22-release",
      "configurePreset": "llvm22-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm22-asan",
      "configurePreset": "llvm22-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1:strict_string_checks=1:quarantine_size_mb=64",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "llvm22-lsan",
      "displayName": "LLVM 22 LeakSanitizer",
      "description": "Targeted leak checks using the ASan and UBSan build",
      "inherits": "llvm22-asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1:quarantine_size_mb=64"
      }
    },
    {
      "name": "windows-clang64-debug",
      "configurePreset": "windows-clang64-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-clang64-release",
      "configurePreset": "windows-clang64-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
