using system, odbc;

namespace access_smoke;

text_driver = "Microsoft Access Text Driver (*.txt, *.csv)";

check name condition
  = () if condition;
  = fprintf stderr "pure-odbc Access smoke failed: %s\n" name $$ exit 1
    otherwise;

has_driver [] = 0;
has_driver ((name,_):xs) = name == text_driver || has_driver xs;
has_driver _ = 0;

driver_recordp (name,attributes)
  = stringp name && listp attributes && all stringp attributes;
driver_recordp _ = 0;

driver_recordsp drivers = listp drivers && all driver_recordp drivers;

driver_status drivers
  = -1 if ~driver_recordsp drivers;
  = 1 if has_driver drivers;
  = 0 otherwise;

csv_test = ()
when
  connection =
    "DRIVER={" + text_driver +
    "};DBQ=.;Extensions=asc,csv,tab,txt;";
  db = odbc::connect connection;
  check "text-driver connection" (pointerp db);
  rows = odbc::sql db
    "SELECT id,name,score,note FROM [people.csv] ORDER BY id" [];
  check "result titles and type conversion"
    (rows ===
      [["id","name","score","note"],
       [1,"Ada",95,"alpha"],
       [2,"Grace",82,odbc::SQLNULL],
       [3,"Linus",70,"gamma"]]);
  parameter_rows = odbc::sql db
    "SELECT id,name,score FROM [people.csv] WHERE id = ?" [2];
  check "bound integer parameter"
    (parameter_rows === [["id","name","score"],[2,"Grace",82]]);
  columns = odbc::sql_exec db
    "SELECT name FROM [people.csv] WHERE id = ?" [3];
  check "low-level statement columns" (columns === ["name"]);
  check "low-level fetch" (odbc::sql_fetch db === ["Linus"]);
  check "statement cleanup" (odbc::sql_close db === ());
  check "connection cleanup" (odbc::disconnect db === ());
  check "stale connection rejected" (~tuplep (odbc::info db));
end;

access_smoke = ()
when
  drivers = odbc::drivers;
  status = driver_status drivers;
  check "driver record shape" (status ~= -1);
  if status then
    csv_test
  else
    puts "PURE_ODBC_TEXT_DRIVER_SKIPPED" $$ exit 77;
end;

access_smoke;
