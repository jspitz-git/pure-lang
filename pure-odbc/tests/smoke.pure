using system, odbc;

namespace smoke;

check name condition
  = () if condition;
  = fprintf stderr "pure-odbc smoke failed: %s\n" name $$ exit 1 otherwise;

stringsp [] = 1;
stringsp (x:xs) = stringp x && stringsp xs;
stringsp _ = 0;

driver_recordsp [] = 1;
driver_recordsp ((name,attributes):xs)
  = stringp name && stringsp attributes && driver_recordsp xs;
driver_recordsp _ = 0;

source_recordsp [] = 1;
source_recordsp ((name,description):xs)
  = stringp name && stringp description && source_recordsp xs;
source_recordsp _ = 0;

diagnosticp (odbc::error msg state)
  = stringp msg && stringp state && state == "IM002";
diagnosticp _ = 0;

smoke = ()
when
  drivers = odbc::drivers;
  sources = odbc::sources;
  check "driver enumeration" (listp drivers);
  check "data-source enumeration" (listp sources);
  check "driver record shape" (driver_recordsp drivers);
  check "data-source record shape" (source_recordsp sources);
  missing =
    odbc::connect "DRIVER={__PURE_MISSING_ODBC_DRIVER__};";
  check "diagnostic propagation" (diagnosticp missing);
end;

smoke;
