using rational, rat_interval;
using namespace rational, interval;

check name condition
  = () if condition;
  = fprintf stderr "FAIL: %s\n" name $$ exit 1 otherwise;

check "rational normalization" (num_den (44%(-14)) == (-22L,7L));
check "rational addition" (5%7 + 2%3 == 29%21);
check "rational comparison" (3%4 < 4%5);
check "mixed-fraction formatting" (str_mixed (11%6) == "1L+5L/6L");
check "mixed-fraction parsing" (val_mixed "1L+5L/6L" == 11%6);
check "interval arithmetic"
  (lo_up (interval (1%3,2%3) + interval (1%6)) == (1%2,5%6));

puts "pure-rational smoke tests passed";
