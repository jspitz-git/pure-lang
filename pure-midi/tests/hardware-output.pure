using system, midi;
extern char *getenv(char *);

namespace hardware_output;

check name condition = () if condition;
  = throw name otherwise;

// Selection is an explicit index or exactly one interface:name match.
numeric s = ~null s && all (\c->c>="0" && c<="9") (chars s);
select selector::string = val selector if numeric selector;
matching selector (interf,name,input,output,opened) = interf+":"+name==selector && output==1;
select selector::string = head matches if #matches==1
  when matches=[i | i=0..midi::device_count-1;
    matching selector (midi::devices!i)] end;
select _ = -1;

// Once Note On succeeds, attempt Note Off even after a caught sleep failure.
play stream = (off==Pm::NoError && played===())
when
  played=catch (\e->e) (check "bounded sleep" (midi::sleep 100 === ()));
  off=midi::writemsg stream 0 {0x80,60,0};
end;

send stream = on==Pm::NoError && play stream
when on=midi::writemsg stream 0 {0x90,60,32} end;

with_stream stream = check "output, Note Off, close" (played===true && closed==Pm::NoError)
when
  played=catch (\e->e) (send stream);
  closed=midi::close stream;
end;

exercise = () when
  id=select (getenv "PURE_MIDI_TEST_OUTPUT");
  check "unique explicit output selector" (id>=0 && id<midi::device_count);
  interf,name,input,output,opened=midi::devices!id;
  check "available output" (output==1 && opened==0);
  printf "INFO: selected output %d|%s|%s\n" (id,interf,name);
  stream=midi::open_output id 0 0;
  check "open output" (midi::streamp stream);
  with_stream stream;
end;

run = if result===() && stopped==Pm::NoError && Pt::Started==0
  then printf "%s\n" (getenv "PURE_MIDI_TEST_TOKEN")
  else (fprintf stderr "FAIL: hardware output or cleanup: %s\n" (str result) $$ fflush stderr $$ exit 1)
when
  result=catch (\e->e) exercise;
  stopped=midi::stop;
end;

hardware_output::run;
