      libmpfr-6.dll libpcre-1.dll libpcreposix-0.dll libreadline8.dll
      libtermcap-0.dll libwinpthread-1.dll libzstd.dll zlib1.dll)
    file(COPY_FILE "${PURE_PREFIX}/bin/${name}" "${private_pure}/bin/${name}")
