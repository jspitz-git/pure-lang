    --target pmlib --parallel 4 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${work}/frozen-input-build.log" "${out}\n${err}")
  if(rc EQUAL 0 OR NOT "${out}${err}" MATCHES "configured inputs changed")
    list(APPEND failures frozen-input-build)
    message(STATUS "frozen-input-build: rejected=${rc}; expected frozen input rejection")
