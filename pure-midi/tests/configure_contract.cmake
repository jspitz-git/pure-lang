function(write_preset output)
  file(WRITE "${output}" "# Independent pure-midi strict audit fixture.\n")
  foreach(key IN LISTS keys)
    if(NOT key STREQUAL omit)
      file(APPEND "${output}" "set(${key} [==[${input_${key}}]==] CACHE STRING \"Explicit audit input\" FORCE)\n")
    endif()
  endforeach()
  file(APPEND "${output}" "set(CMAKE_BUILD_TYPE Release CACHE STRING \"\" FORCE)\nset(BUILD_TESTING ON CACHE BOOL \"\" FORCE)\n")
endfunction()
