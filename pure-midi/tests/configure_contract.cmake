# Check actual compiler dependencies, not only the hashes of unused input paths.
# The alternate headers are valid but byte-different copies in an accepted Pure
# prefix. They must never replace the explicit CLANG64 inputs for either module.
if(NOT DEFINED CASE_FILTER OR "header-shadow" MATCHES "${CASE_FILTER}")
  set(shadow_pure "${work}/shadow-pure")
  foreach(key IN LISTS keys)
    set(shadow_original_${key} "${input_${key}}")
    if(NOT key STREQUAL "PURE_MIDI_RUNTIME_SOURCES" AND
        input_${key} MATCHES "^${PURE_PREFIX}/" AND NOT IS_DIRECTORY "${input_${key}}")
      string(REPLACE "${PURE_PREFIX}" "${shadow_pure}" dest "${input_${key}}")
      get_filename_component(parent "${dest}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(COPY_FILE "${input_${key}}" "${dest}")
    endif()
    string(REPLACE "${PURE_PREFIX}" "${shadow_pure}" input_${key} "${input_${key}}")
  endforeach()
  foreach(name pure.exe libpure.dll libc++.dll libgmp-10.dll libiconv-2.dll
      libmpfr-6.dll libpcre-1.dll libpcreposix-0.dll libreadline8.dll
      libtermcap-0.dll libwinpthread-1.dll libzstd.dll zlib1.dll)
    file(COPY_FILE "${PURE_PREFIX}/bin/${name}" "${shadow_pure}/bin/${name}")
  endforeach()
  foreach(header portmidi.h porttime.h gmp.h mpfr.h windows.h)
    file(COPY_FILE "${CLANG64_PREFIX}/include/${header}" "${shadow_pure}/include/${header}")
    file(APPEND "${shadow_pure}/include/${header}" "\n/* stale owned shadow of ${header} */\n")
    file(SHA256 "${CLANG64_PREFIX}/include/${header}" pristine_hash)
    file(SHA256 "${shadow_pure}/include/${header}" shadow_hash)
    if(pristine_hash STREQUAL shadow_hash)
      message(FATAL_ERROR "Shadow header fixture did not change ${header}")
    endif()
  endforeach()
  write_preset("${work}/header-shadow.cmake")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${work}/header-shadow"
    -G Ninja -C "${work}/header-shadow.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${work}/header-shadow-configure.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Independent shadow-prefix configure failed: ${out}${err}")
  endif()
  math(EXPR positive "${positive}+1")
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/header-shadow"
    --target pmlib midifile --parallel 4
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${work}/header-shadow-build.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Valid shadow-header fixture build failed: ${out}${err}")
  endif()
  math(EXPR positive "${positive}+1")
  foreach(row "pmlib.dir/pmdev.c.obj|portmidi.h,gmp.h,mpfr.h"
      "pmlib.dir/midi_stream.c.obj|porttime.h,windows.h"
      "midifile.dir/midifile/mf.c.obj|gmp.h,mpfr.h")
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 object)
    list(GET fields 1 headers)
    string(REPLACE "," ";" headers "${headers}")
    execute_process(COMMAND "${CLANG64_PREFIX}/bin/ninja.exe" -C "${work}/header-shadow"
      -t deps "CMakeFiles/${object}" RESULT_VARIABLE rc OUTPUT_VARIABLE deps ERROR_VARIABLE err)
    file(APPEND "${work}/header-shadow-dependencies.log" "${deps}\n${err}")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "Cannot inspect actual compiler dependencies: ${err}")
    endif()
    string(REPLACE "\r" "" deps "${deps}")
    string(REPLACE "\n" ";" deps "${deps}")
    list(TRANSFORM deps STRIP)
    list(TRANSFORM deps TOLOWER)
    foreach(header IN LISTS headers)
      string(TOLOWER "${CLANG64_PREFIX}/include/${header}" required)
      string(TOLOWER "${shadow_pure}/include/${header}" forbidden)
      if(NOT required IN_LIST deps OR forbidden IN_LIST deps)
        list(APPEND failures "header-shadow-${object}-${header}")
        message(STATUS "header-shadow: ${object} consumed alternate ${header}")
      endif()
      math(EXPR negative "${negative}+1")
    endforeach()
    if(NOT object STREQUAL "pmlib.dir/midi_stream.c.obj")
      foreach(header pure/runtime.h glob.h)
        string(TOLOWER "${shadow_pure}/include/${header}" required)
        if(NOT required IN_LIST deps)
          message(FATAL_ERROR "Declared Pure ${header} was not used by ${object}")
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(key IN LISTS keys)
    set(input_${key} "${shadow_original_${key}}")
  endforeach()
endif()

if(NOT DEFINED CASE_FILTER OR "build-ambient" MATCHES "${CASE_FILTER}")
  # Keep these paths distinct: Clang deduplicates CPATH against C_INCLUDE_PATH
  # as a system path, which can otherwise hide the intended shadow-header RED.
  file(MAKE_DIRECTORY "${work}/build-poison/CPATH/pure")
  file(WRITE "${work}/build-poison/CPATH/pure/runtime.h" "#error MIDI_UNDECLARED_BUILD_HEADER\n")
  set(poison_variables CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH
    LIBRARY_PATH COMPILER_PATH GCC_EXEC_PREFIX INCLUDE LIB LIBPATH CL _CL_ LINK _LINK_
    CFLAGS CPPFLAGS LDFLAGS CCC_OVERRIDE_OPTIONS CCC_ADD_ARGS SDKROOT DEVELOPER_DIR
    CLANG_CONFIG_FILE_SYSTEM_DIR CLANG_CONFIG_FILE_USER_DIR)
  foreach(var IN LISTS poison_variables)
    set(saved_environment_${var} "$ENV{${var}}")
    file(MAKE_DIRECTORY "${work}/build-poison/${var}")
    set(ENV{${var}} "${work}/build-poison/${var}")
  endforeach()
  set(ENV{CCC_OVERRIDE_OPTIONS} "+--midi-audit-invalid-ambient-option")
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/pristine-explicit-poisoned"
    --parallel 4 --verbose RESULT_VARIABLE build_rc OUTPUT_VARIABLE build_out ERROR_VARIABLE build_err TIMEOUT 90)
  file(WRITE "${work}/build-ambient.log" "${build_out}\n${build_err}")
  foreach(var IN LISTS poison_variables)
    if(saved_environment_${var} STREQUAL "")
      unset(ENV{${var}})
    else()
      set(ENV{${var}} "${saved_environment_${var}}")
    endif()
  endforeach()
  if(NOT build_rc EQUAL 0)
    message(STATUS "build-ambient: ${build_out}\n${build_err}")
    list(APPEND failures build-ambient)
  endif()
  math(EXPR positive "${positive}+1")
  # The compiler/linker launcher is deliberately not a user cache override.
  # Reconfigure must accept our fixed defaults without weakening the gate.
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}"
    -B "${work}/pristine-explicit-poisoned" -G Ninja
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${work}/reconfigure-pristine.log" "${out}\n${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Fixed strict reconfigure failed: ${out}\n${err}")
  endif()
  math(EXPR positive "${positive}+1")
endif()

# Non-strict mode must still accept ordinary upstream discovery.
set(input_PURE_MIDI_STRICT_WINDOWS_AUDIT OFF)
unset(input_CMAKE_C_COMPILER_TARGET)
set(ENV{MSYSTEM_PREFIX} "${CLANG64_PREFIX}")
set(ENV{PKG_CONFIG_PATH} "${PURE_PREFIX}/lib/pkgconfig;${CLANG64_PREFIX}/lib/pkgconfig")
configure_case(normal-upstream TRUE)
if(failures)
  message(FATAL_ERROR "Configure contract failures (${work}): ${failures}")
endif()
execute_process(COMMAND "${RUNNER}" --owned-clean --cwd "${work}" --token "${owner}"
  RESULT_VARIABLE cleanup_rc)
if(NOT cleanup_rc EQUAL 0)
  message(FATAL_ERROR "Owned contract cleanup failed")
endif()
message(STATUS "CONFIGURE_CONTRACT_OK negative=${negative} positive=${positive} skipped_symlink=${skipped_symlink}")
