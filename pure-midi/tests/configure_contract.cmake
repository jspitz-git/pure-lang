function(configure_case name accept)
  if(DEFINED CASE_FILTER AND NOT name MATCHES "${CASE_FILTER}")
    return()
  endif()
  write_preset("${work}/${name}.cmake")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}"
    -B "${work}/${name}" -G Ninja -C "${work}/${name}.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  file(WRITE "${work}/${name}.log" "${out}\n${err}")
  if(accept)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "${name}: pristine configure failed (${rc}): ${out}\n${err}")
    endif()
    math(EXPR count "${positive}+1")
    set(positive "${count}" PARENT_SCOPE)
  else()
    if(NOT DEFINED expected_rejection)
      set(expected_rejection "midi audit:")
    endif()
    if(rc EQUAL 0 OR NOT "${out}${err}" MATCHES "${expected_rejection}")
      message(STATUS "${name}: rejected=${rc}; expected an audit rejection")
      list(APPEND failures "${name}")
      set(failures "${failures}" PARENT_SCOPE)
    endif()
    math(EXPR count "${negative}+1")
    set(negative "${count}" PARENT_SCOPE)
  endif()
endfunction()

