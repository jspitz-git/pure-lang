# Characteristics are structured flag records, not arbitrary numeric fields.
# Mutate complete real records while keeping every import and other header intact.
foreach(mutation file-scalar optional-scalar file-duplicate optional-duplicate
    file-unknown optional-unknown file-bit-mismatch optional-bit-mismatch
    file-mask-mismatch optional-mask-mismatch no-executable no-large-address
    invalid-32bit missing-dll no-dynamic-base no-high-entropy no-nx)
  set(records "${midi_records}")
  if(mutation STREQUAL "file-scalar")
    string(REGEX REPLACE "  Characteristics \\[ \\(0x2022\\)[^]]*\\]" "  Characteristics: 0x2022" records "${records}")
  elseif(mutation STREQUAL "optional-scalar")
    string(REGEX REPLACE "  Characteristics \\[ \\(0x160\\)[^]]*\\]" "  Characteristics: 0x160" records "${records}")
  elseif(mutation STREQUAL "file-duplicate")
    string(REPLACE "    IMAGE_FILE_DLL (0x2000)" "    IMAGE_FILE_DLL (0x2000)\n    IMAGE_FILE_DLL (0x2000)" records "${records}")
  elseif(mutation STREQUAL "optional-duplicate")
    string(REPLACE "    IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)" "    IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)\n    IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)" records "${records}")
  elseif(mutation STREQUAL "file-unknown")
    string(REPLACE "    IMAGE_FILE_DLL (0x2000)" "    IMAGE_FILE_BOGUS (0x2000)" records "${records}")
  elseif(mutation STREQUAL "optional-unknown")
    string(REPLACE "    IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)" "    IMAGE_DLL_CHARACTERISTICS_BOGUS (0x100)" records "${records}")
  elseif(mutation STREQUAL "file-bit-mismatch")
    string(REPLACE "IMAGE_FILE_DLL (0x2000)" "IMAGE_FILE_DLL (0x200)" records "${records}")
  elseif(mutation STREQUAL "optional-bit-mismatch")
    string(REPLACE "IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)" "IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x10)" records "${records}")
  elseif(mutation STREQUAL "file-mask-mismatch")
    string(REPLACE "Characteristics [ (0x2022)" "Characteristics [ (0x2023)" records "${records}")
  elseif(mutation STREQUAL "optional-mask-mismatch")
    string(REPLACE "Characteristics [ (0x160)" "Characteristics [ (0x161)" records "${records}")
  elseif(mutation STREQUAL "no-executable")
    string(REPLACE "    IMAGE_FILE_EXECUTABLE_IMAGE (0x2)\n" "" records "${records}")
    string(REPLACE "Characteristics [ (0x2022)" "Characteristics [ (0x2020)" records "${records}")
  elseif(mutation STREQUAL "no-large-address")
    string(REPLACE "    IMAGE_FILE_LARGE_ADDRESS_AWARE (0x20)\n" "" records "${records}")
    string(REPLACE "Characteristics [ (0x2022)" "Characteristics [ (0x2002)" records "${records}")
  elseif(mutation STREQUAL "invalid-32bit")
    string(REPLACE "Characteristics [ (0x2022)" "Characteristics [ (0x2122)\n    IMAGE_FILE_32BIT_MACHINE (0x100)" records "${records}")
  elseif(mutation STREQUAL "missing-dll")
    string(REPLACE "    IMAGE_FILE_DLL (0x2000)\n" "" records "${records}")
    string(REPLACE "Characteristics [ (0x2022)" "Characteristics [ (0x22)" records "${records}")
  elseif(mutation STREQUAL "no-dynamic-base")
