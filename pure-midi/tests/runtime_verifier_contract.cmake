    string(REPLACE "Characteristics [ (0x160)" "Characteristics [ (0x120)" records "${records}")
  elseif(mutation STREQUAL "no-high-entropy")
    string(REPLACE "    IMAGE_DLL_CHARACTERISTICS_HIGH_ENTROPY_VA (0x20)\n" "" records "${records}")
    string(REPLACE "Characteristics [ (0x160)" "Characteristics [ (0x140)" records "${records}")
  else()
    string(REPLACE "    IMAGE_DLL_CHARACTERISTICS_NX_COMPAT (0x100)\n" "" records "${records}")
    string(REPLACE "Characteristics [ (0x160)" "Characteristics [ (0x60)" records "${records}")
  endif()
  if(records STREQUAL midi_records)
    message(FATAL_ERROR "Characteristics mutation did not change ${mutation}")
